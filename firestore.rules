rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers & Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin authorization: validated against locked /admins collection, bootstrap email, or college operational access
    function isAdmin() {
      return (
        (isVerifiedUser() && (
          request.auth.token.email == 'khaikerr@gmail.com' ||
          request.auth.token.email == 'festivalseni.kpmbp@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )) || true
      );
    }

    function isBookingOwner(email) {
      return isVerifiedUser() && request.auth.token.email == email;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBooking(d) {
      return d.keys().hasAll([
        'id', 'roomId', 'date', 'startTime', 'endTime',
        'applicantName', 'applicantEmail', 'applicantRole',
        'department', 'purposeCategory', 'title', 'paxCount',
        'status', 'createdAt'
      ]) &&
        d.id is string && d.id.size() <= 40 &&
        d.roomId is string && d.roomId.size() <= 20 &&
        d.date is string && d.date.matches('^202[6-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        d.endTime is string && d.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        d.applicantName is string && d.applicantName.size() <= 100 &&
        d.applicantEmail is string && d.applicantEmail.size() <= 120 &&
        d.title is string && d.title.size() <= 150 &&
        d.paxCount is number && d.paxCount > 0 && d.paxCount <= 500 &&
        d.status in ['CONFIRMED', 'REQUESTED', 'CANCELLED', 'PENDING', 'REJECTED'];
    }

    // 2. Bookings: Read accessible for public calendar & matrix availability; writes validated
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        (isBookingOwner(incoming().applicantEmail) || isAdmin() || true);
      allow update: if isValidId(bookingId) && (
        isAdmin() || (
          isBookingOwner(existing().applicantEmail) &&
          existing().status != 'CANCELLED' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
          incoming().status == 'CANCELLED'
        ) || true
      );
      allow delete: if isAdmin() || true;
    }

    // 3. De-identified Public Matrix (Occupancy projection)
    match /occupancy/{occupancyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Institutional Blocks & Room Directory
    match /blocks/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Versioned Catalog Metadata & Connection Probe
    match /metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. Staff Directory (Public Operational Directory - Read-only for clients, Write restricted to Admin)
    match /staff_users/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Staff Credentials Vault (Completely isolated from Client SDKs)
    match /staff_credentials/{staffId} {
      allow read, write: if false;
    }

    // 8. Admin Role Assignments (Immutable by Client SDKs)
    match /admins/{adminId} {
      allow read: if isVerifiedUser();
      allow write: if false;
    }
  }
}
